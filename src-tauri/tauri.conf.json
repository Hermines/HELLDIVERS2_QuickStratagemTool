{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HD2 Macro Terminal Rust",
  "version": "2.0.9",
  "identifier": "com.hd2.trigger.rust",
  "build": {
    "frontendDist": "../ui",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HD2 Macro Terminal",
        "width": 1024,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src https:;",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "resources": {
      "resources/": ""
    }
  }
}
